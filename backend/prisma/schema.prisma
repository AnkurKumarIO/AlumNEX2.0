generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  role                String   @default("STUDENT")
  username            String?  @unique
  password            String?
  name                String
  email               String   @unique
  department          String?
  verification_status String   @default("PENDING")
  profile_data        String?
  google_refresh_token String?

  company             String?
  batch_year          Int?
  college_id          String?

  given_slots         ScheduleSlot[]    @relation("AlumniSlots")
  booked_slots        ScheduleSlot[]    @relation("StudentBookings")
  student_interviews  InterviewRecord[] @relation("StudentInterviews")
  alumni_interviews   InterviewRecord[] @relation("AlumniInterviews")
  
  sent_requests       InterviewRequest[] @relation("StudentRequests")
  received_requests   InterviewRequest[] @relation("AlumniRequests")
  notifications       Notification[]

  student_sessions    SessionFeedback[]  @relation("StudentSessions")
  alumni_sessions     SessionFeedback[]  @relation("AlumniSessions")
  
  profile_assets      ProfileAsset[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("users")
}

model InterviewRequest {
  request_id               String   @id @default(uuid())
  student_id               String
  alumni_id                String
  topic                    String
  message                  String?
  status                   String   @default("PENDING")
  scheduled_time           DateTime?
  room_id                  String?
  student_profile_snapshot String?

  student                  User     @relation("StudentRequests", fields: [student_id], references: [id], onDelete: Cascade)
  alumni                   User     @relation("AlumniRequests", fields: [alumni_id], references: [id], onDelete: Cascade)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([student_id])
  @@index([alumni_id])
  @@index([status])
  @@map("interview_requests")
}

model Notification {
  id          String   @id @default(uuid()) @map("notification_id")
  user_id     String
  type        String
  title       String
  message     String
  read        Boolean  @default(false)
  request_id  String?

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([user_id])
  @@index([user_id, read])
  @@map("notifications")
}

model ScheduleSlot {
  slot_id    String   @id @default(uuid())
  alumni_id  String
  student_id String?
  start_time DateTime
  end_time   DateTime
  status     String   @default("OPEN")

  alumni     User     @relation("AlumniSlots", fields: [alumni_id], references: [id], onDelete: Cascade)
  student    User?    @relation("StudentBookings", fields: [student_id], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("schedule_slots")
}

model InterviewRecord {
  interview_id    String   @id @default(uuid())
  student_id      String
  alumni_id       String
  transcript      String?
  student_score   Float?
  alumni_feedback String?
  ai_action_items String?

  request_id      String?  @unique
  status          String   @default("COMPLETED")

  student         User     @relation("StudentInterviews", fields: [student_id], references: [id], onDelete: Cascade)
  alumni          User     @relation("AlumniInterviews", fields: [alumni_id], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([student_id])
  @@index([alumni_id])
  @@map("interview_records")
}

model SessionFeedback {
  id              String   @id @default(uuid())
  room_id         String   @unique
  topic           String?
  meet_link       String?

  student_id      String
  alumni_id       String
  student_name    String?
  alumni_name     String?

  student_rating   Int?
  student_feedback String?
  alumni_rating    Int?
  alumni_feedback  String?

  duration_minutes Int?
  status           String   @default("COMPLETED")

  student         User     @relation("StudentSessions", fields: [student_id], references: [id], onDelete: Cascade)
  alumni          User     @relation("AlumniSessions", fields: [alumni_id], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("session_feedbacks")
}

model ActivityLog {
  id        String   @id @default(uuid())
  icon      String
  color     String
  title     String
  desc      String
  category  String   @default("general")
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_configs")
}

model CollegeRegistry {
  college_id String @id
  name       String
  department String

  @@map("college_registry")
}

model ProfileAsset {
  id         String   @id @default(uuid())
  user_id    String
  asset_type String   // 'photo' or 'resume'
  file_name  String?
  mime_type  String?
  file_data  String   // Base64 encoded
  file_size  Int?
  
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  @@unique([user_id, asset_type])
  @@index([user_id])
  @@index([user_id, asset_type])
  @@map("profile_assets")
}
