generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  role                String   @default("STUDENT")
  username            String?  @unique
  password            String?
  name                String
  email               String   @unique
  department          String?
  verification_status String   @default("PENDING")
  is_banned           Boolean  @default(false)
  profile_data        String?
  google_refresh_token String?

  company             String?
  batch_year          Int?
  college_id          String?

  weekly_request_tokens    Int     @default(5)
  tokens_reset_at          DateTime?
  max_interviews_per_week  Int     @default(3)

  availability_slots   AlumniAvailability[]
  weekly_trackers      WeeklyRequestTracker[]
  booked_slots         BookedSlot[]         @relation("StudentBookings")
  alumni_booked_slots  BookedSlot[]         @relation("AlumniBookings")

  student_interviews  InterviewRecord[] @relation("StudentInterviews")
  alumni_interviews   InterviewRecord[] @relation("AlumniInterviews")
  
  sent_requests       InterviewRequest[] @relation("StudentRequests")
  received_requests   InterviewRequest[] @relation("AlumniRequests")
  notifications       Notification[]

  student_sessions    SessionFeedback[]  @relation("StudentSessions")
  alumni_sessions     SessionFeedback[]  @relation("AlumniSessions")
  
  profile_assets      ProfileAsset[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("users")
}

model InterviewRequest {
  request_id               String   @id @default(uuid())
  student_id               String
  alumni_id                String
  topic                    String
  message                  String?
  status                   String   @default("PENDING")
  scheduled_time           DateTime?
  room_id                  String?
  student_profile_snapshot String?

  student                  User     @relation("StudentRequests", fields: [student_id], references: [id], onDelete: Cascade)
  alumni                   User     @relation("AlumniRequests", fields: [alumni_id], references: [id], onDelete: Cascade)
  booked_slot              BookedSlot?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([student_id])
  @@index([alumni_id])
  @@index([status])
  @@map("interview_requests")
}

model Notification {
  id          String   @id @default(uuid()) @map("notification_id")
  user_id     String
  type        String
  title       String
  message     String
  read        Boolean  @default(false)
  request_id  String?
  room_id     String?

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([user_id])
  @@index([user_id, read])
  @@map("notifications")
}

model WeeklyRequestTracker {
  id              String   @id @default(uuid())
  student_id      String
  week_start      DateTime
  tokens_used     Int      @default(0)
  bonus_granted   Boolean  @default(false)
  interviews_done Int      @default(0)
  created_at      DateTime @default(now())

  student         User     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, week_start])
  @@map("weekly_request_trackers")
}

model AlumniAvailability {
  id              String   @id @default(uuid())
  alumni_id       String
  day_of_week     String   // 'monday','tuesday',...,'sunday'
  start_time      String   // e.g. "17:00"
  end_time        String   // e.g. "19:00"
  slot_duration   Int      @default(60)  // minutes per interview
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  alumni          User     @relation(fields: [alumni_id], references: [id], onDelete: Cascade)

  @@unique([alumni_id, day_of_week, start_time])
  @@map("alumni_availabilities")
}

model BookedSlot {
  id              String   @id @default(uuid())
  request_id      String   @unique
  alumni_id       String
  student_id      String
  slot_start      DateTime
  slot_end        DateTime
  status          String   @default("BOOKED") // 'BOOKED','COMPLETED','NO_SHOW','CANCELLED'

  request         InterviewRequest @relation(fields: [request_id], references: [request_id], onDelete: Cascade)
  alumni          User             @relation("AlumniBookings", fields: [alumni_id], references: [id])
  student         User             @relation("StudentBookings", fields: [student_id], references: [id])

  created_at      DateTime @default(now())

  @@map("booked_slots")
}

model InterviewRecord {
  interview_id    String   @id @default(uuid())
  student_id      String
  alumni_id       String
  transcript      String?
  student_score   Float?
  alumni_feedback String?
  ai_action_items String?

  request_id      String?  @unique
  status          String   @default("COMPLETED")

  student         User     @relation("StudentInterviews", fields: [student_id], references: [id], onDelete: Cascade)
  alumni          User     @relation("AlumniInterviews", fields: [alumni_id], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([student_id])
  @@index([alumni_id])
  @@map("interview_records")
}

model SessionFeedback {
  id              String   @id @default(uuid())
  room_id         String   @unique
  topic           String?
  meet_link       String?

  student_id      String
  alumni_id       String
  student_name    String?
  alumni_name     String?

  student_rating   Int?
  student_feedback String?
  alumni_rating    Int?
  alumni_feedback  String?

  duration_minutes Int?
  status           String   @default("COMPLETED")

  student         User     @relation("StudentSessions", fields: [student_id], references: [id], onDelete: Cascade)
  alumni          User     @relation("AlumniSessions", fields: [alumni_id], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("session_feedbacks")
}

model ActivityLog {
  id        String   @id @default(uuid())
  icon      String
  color     String
  title     String
  desc      String
  category  String   @default("general")
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model PlatformConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_configs")
}

model CollegeRegistry {
  college_id String @id
  name       String
  department String

  @@map("college_registry")
}

model ProfileAsset {
  id         String   @id @default(uuid())
  user_id    String
  asset_type String   // 'photo' or 'resume'
  file_name  String?
  mime_type  String?
  file_data  String?  // Base64 encoded (legacy — nullable, prefer asset_url)
  asset_url  String?  // Supabase Storage public URL (preferred)
  storage_path String? // Supabase Storage path (for deletion)
  file_size  Int?
  
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  @@unique([user_id, asset_type])
  @@index([user_id])
  @@index([user_id, asset_type])
  @@map("profile_assets")
}
